    {
      "id": "75657a1c-193f-4542-88c8-db9443089b17",
      "name": "Ready",
      "description": {
        "content": "Readiness check endpoints that indicate whether CoreDNS plugins have finished initializing and are ready to serve DNS queries.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "37a2f50c-c54c-4713-bcea-a38b9f5151e5",
          "name": "CoreDNS readiness check",
          "request": {
            "name": "CoreDNS readiness check",
            "description": {
              "content": "Returns the readiness status of all CoreDNS plugins. Returns HTTP 200 with body \"OK\" when all plugins that implement the Readiness interface report they are ready to serve traffic. Returns HTTP 503 if any plugin is not yet ready. This endpoint is typically used as the Kubernetes readiness probe target and requires the ready plugin to be enabled in the Corefile.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ready"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "24ed7c86-7e29-409c-8ea2-9503e3475f08",
              "name": "All CoreDNS plugins are ready to serve traffic.",
              "originalRequest": {
                "url": {
                  "path": [
                    "ready"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "text/plain"
                  }
                ],
                "method": "GET",
                "body": {}
