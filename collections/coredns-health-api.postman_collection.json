      "name": "Health",
      "description": {
        "content": "Health check endpoints used by Kubernetes liveness and readiness probes to assess the operational state of the CoreDNS process.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6306e7bf-69da-46f4-89ee-3983bd3c4d90",
          "name": "CoreDNS liveness health check",
          "request": {
            "name": "CoreDNS liveness health check",
            "description": {
              "content": "Returns the overall health status of the CoreDNS process. Returns HTTP 200 with body \"OK\" when CoreDNS is alive and healthy. Returns HTTP 503 during the lameduck shutdown period to signal that the instance is draining and should not receive new traffic. This endpoint is typically used as the Kubernetes liveness probe target.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "health"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "38b137f3-58e1-4738-aa5e-d89783c5073b",
              "name": "CoreDNS is healthy and alive.",
              "originalRequest": {
                "url": {
                  "path": [
                    "health"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
